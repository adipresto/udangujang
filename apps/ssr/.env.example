# DAS gRPC endpoint reachable from the SSR server process.
DAS_GRPC_ADDR=localhost:50051

# Firebase Auth client config (project: atminujangudang). Wiring only for
# now — no admin login UI yet. Values from Firebase console > Project
# settings > General > Your apps.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Admin allowlist for the /admin guard (comma-separated emails).
# Empty = any authenticated Firebase user may access /admin.
NEXT_PUBLIC_ADMIN_EMAILS=
